; The simulator suite of cistern.mysql (DESIGN.md, "Tests"): a fake server in
; the in-memory network of Weft_sim, and the real Connection.connect. -linkall
; puts each module of the libraries in the catalogue of the mutation gate (make
; check-scope).

; CISTERN_SLOW adds the slow storm (test_sim.ml). It is a dependency, thus dune
; runs the test again when it changes.

(test
 (name test_sim)
 (libraries
  cistern
  cistern.core
  cistern_test_models
  cistern.mysql
  weft
  weft.flow
  weft.sim
  weft-tls
  tls
  x509
  cistern_certgen
  mirage-crypto-rng
  ptime
  windtrap)
 (deps
  (env_var CISTERN_SLOW))
 (link_flags (-linkall)))
