; The type-error tests of cistern.core (DESIGN.md, "Tests"). Each rule types
; one file that the compiler must refuse (exit status 2), and keeps the
; message. test_typeerr.ml compares each message with its .expected file. A
; file that types makes its rule fail.

(rule
 (deps
  mix_expr.ml
  (glob_files %{project_root}/core/.cistern_core.objs/byte/*.cmi)
  (glob_files %{project_root}/names/.cistern_names.objs/byte/*.cmi))
 (action
  (with-outputs-to
   mix_expr.out
   (with-accepted-exit-codes
    2
    (run
     %{ocamlc}
     -color
     never
     -stop-after
     typing
     -I
     %{project_root}/core/.cistern_core.objs/byte
     -I
     %{project_root}/names/.cistern_names.objs/byte
     mix_expr.ml)))))

(rule
 (deps
  mix_update.ml
  (glob_files %{project_root}/core/.cistern_core.objs/byte/*.cmi)
  (glob_files %{project_root}/names/.cistern_names.objs/byte/*.cmi))
 (action
  (with-outputs-to
   mix_update.out
   (with-accepted-exit-codes
    2
    (run
     %{ocamlc}
     -color
     never
     -stop-after
     typing
     -I
     %{project_root}/core/.cistern_core.objs/byte
     -I
     %{project_root}/names/.cistern_names.objs/byte
     mix_update.ml)))))

