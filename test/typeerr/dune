(test
 (name test_typeerr)
 (modules test_typeerr)
 (libraries windtrap)
 (deps
  mix_expr.out
  mix_expr.expected
  mix_update.out
  mix_update.expected
  starts_with_int.out
  starts_with_int.expected
  starts_with_option.out
  starts_with_option.expected
  starts_with_opt_string.out
  starts_with_opt_string.expected))
