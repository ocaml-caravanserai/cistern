# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "An ORM for OCaml 5.5 on weft, for MySQL and MariaDB"
description:
  "Cistern defines models as OCaml records with a deriver, and runs typed queries on MySQL and MariaDB through a pure OCaml client on weft."
license: "MPL-2.0"
homepage: "https://github.com/ocaml-caravanserai/cistern"
bug-reports: "https://github.com/ocaml-caravanserai/cistern/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.5"}
  "weft"
  "windtrap" {with-test & >= "0.3.0"}
  "ppx_windtrap" {with-test & >= "0.3.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ocaml-caravanserai/cistern.git"
x-maintenance-intent: ["(latest)"]
